// Resource script for th07.exe. Configured by CMake, which fills in the paths.
//
// The icon gives the executable its own face in Explorer and the taskbar. The font is the
// large read-only blob the text renderer reads; keeping it in the resource section means it
// never has to sit beside the executable as a loose file.

#include <windows.h>

// Application icon. Windows picks the closest size it needs from the .ico.
1 ICON "@TH07_ICON@"

// The text font, read by EmbeddedAssets::OpenFontStream.
TH07_FONT RCDATA "@TH07_FONT@"

// Version information, shown in the file's properties dialog.
VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Team Shanghai Alice"
            VALUE "FileDescription",  "Touhou Youyoumu ~ Perfect Cherry Blossom"
            VALUE "FileVersion",      "1.00b"
            VALUE "InternalName",     "th07"
            VALUE "OriginalFilename", "th07.exe"
            VALUE "ProductName",      "Touhou Youyoumu ~ Perfect Cherry Blossom"
            VALUE "ProductVersion",   "1.00b"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
