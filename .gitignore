# Build output.
build/

# assets/ is committed, but only the content the project has modernised. Original game
# data that happens to be staged there must not enter the repository: the archive is
# extracted at build time instead. See assets/README.md.
assets/**/*.anm
assets/**/*.ecl
assets/**/*.dat
assets/**/*.rpy
assets/**/*.jpg
assets/**/*.wav
assets/**/*.mid
assets/**/*.sht
assets/**/*.std
assets/**/*.end
assets/**/*.fmt

# Local toolchains and SDKs. None of these are source: SDL packages, the retail data
# files and the font are downloaded or copied in separately.
.tools/

# Python bytecode from the build scripts.
__pycache__/
scripts/__pycache__/

# Original game executables, which this project never distributes.
resources/th07.exe
resources/custom.exe

# Editor and tooling scratch.
*.gpr
*.lock
*.rep
*.swp
*.swo
*~
.venv*
compile_commands.json
reccmp-user.yml
reccmp-build.yml
reccmp-gui.yml

# Generated localisation tables.
src/th07/i18n.hpp
src/custom/i18n.hpp
