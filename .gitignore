# Build output.
build/

# assets/ is committed: what is there is the project's own content, converted from the game's
# original data and edited as source. The archive those came from is never committed, and the
# rules below keep any copy of it out if one is ever staged here by hand. See assets/README.md.
assets/**/*.anm
assets/**/*.ecl
assets/**/*.dat
assets/**/*.rpy
assets/**/*.jpg
assets/**/*.wav
assets/**/*.mid
assets/**/*.sht
assets/**/*.std
assets/**/*.end
assets/**/*.fmt
assets/**/*.bin

# Local toolchains and SDKs. None of these are source: SDL packages, the retail data
# files and the font are downloaded or copied in separately.
.tools/

# Python bytecode from the build scripts.
__pycache__/
scripts/__pycache__/

# Original game executables, which this project never distributes.
resources/th07.exe
resources/custom.exe

# Editor and tooling scratch.
*.gpr
*.lock
*.rep
*.swp
*.swo
*~
.venv*
compile_commands.json
reccmp-user.yml
reccmp-build.yml
reccmp-gui.yml

# Generated localisation tables.
src/th07/i18n.hpp
src/custom/i18n.hpp
